# ====================================================================
# Git Ignore for Rename File Viet (Monorepo: C# .NET 11 & Rust Tauri)
# ====================================================================

# OS generated files
[Dd]esktop.ini
[Tt]humbs.db
.DS_Store

# IDE & Editor files
.vs/
.vscode/
.idea/
.antigravity/
*.user
*.suo
*.userosscache
*.sln.docstates

# --------------------------------------------------------------------
# C# .NET Build Artifacts
# --------------------------------------------------------------------
**/[Bb]in/
**/[Oo]bj/
**/[Oo]ut/
CSharp_AdvancedFileRenamer/
*.pdb
*.dll
*.exe

# --------------------------------------------------------------------
# Node.js & React Build Artifacts
# --------------------------------------------------------------------
**/node_modules/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.local
.env.*.local

# --------------------------------------------------------------------
# Rust & Cargo Build Artifacts
# --------------------------------------------------------------------
**/target/
**/*.rs.bk
Cargo.lock.bak
*.old

# Ignore built standalone release packages
*.zip
*.tar.gz
*.msi
