<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>CSharpFileRenamer</RootNamespace>
    <AssemblyName>RenameFileViet</AssemblyName>
    <RepositoryUrl>https://github.com/nguyenductai1983/RenameFile</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nguyenductai1983/RenameFile</PackageProjectUrl>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>

</Project>
