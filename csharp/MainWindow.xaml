<Window x:Class="CSharpFileRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rename File Viet — Tiện Ích Đổi Tên Tệp Tiếng Việt &amp; Nén Ảnh Hàng Loạt (.NET 11)" 
        Height="820" Width="1280" 
        MinHeight="660" MinWidth="1020"
        Background="{DynamicResource ThemeBgWindow}" Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Segmented Tab / Pill Radio Button Style -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource ThemeTabActiveBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource ThemeCardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Mode Switcher Radio Button Style (Top Header) -->
        <Style x:Key="HeaderModeRadioButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="modePill" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="modePill" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="modePill" Property="Background" Value="{DynamicResource ThemeCardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Chip Radio Button Style -->
        <Style x:Key="FilterChipRadioButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource ThemeTabActiveBg}"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource ThemeCardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent Base Button Style -->
        <Style x:Key="FluentButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource ThemeBgCardAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ThemeCardHover}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="PrimaryAccentButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ThemeAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Accent Button Style -->
        <Style x:Key="DangerAccentButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: TOP HEADER & WORKSPACE NAVIGATION                -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo & Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0" Cursor="Hand" MouseLeftButtonDown="BrandLogo_MouseDown" ToolTip="Bấm để xem giới thiệu &amp; cập nhật phiên bản mới">
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Utility Buttons -->

                    <Button x:Name="BtnThemeToggle" Content="🌓 Tự động" Click="BtnThemeToggle_Click" 
         Style="{StaticResource FluentButtonStyle}" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,6,2"
         ToolTip="Tự động / Tối /Sáng"/>
                </StackPanel>

                <!-- Center Mode Switcher (Modern Segmented Pill Switcher) -->
                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RadModeRename" Content="🏷️  Đổi Tên Tệp" IsChecked="True" Checked="OnModeChanged"
                                     Style="{StaticResource HeaderModeRadioButtonStyle}"/>
                        <RadioButton x:Name="RadModeImage" Content="🖼️  Nén &amp; Giảm Kích Thước Ảnh (0)" Checked="OnModeChanged"
                                     Style="{StaticResource HeaderModeRadioButtonStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Right Actions Cluster -->
                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Source Selection: Folder & Files -->
                    <Button Content="📂 Chọn Thư Mục" Click="BtnScanFolder_Click" 
                            Style="{StaticResource FluentButtonStyle}" Margin="0,2,6,2"
                            ToolTip="Quét toàn bộ tệp tin trong một thư mục (hỗ trợ thư mục con)"/>

                    <Button Content="📄 Chọn Tệp Tin" Click="BtnSelectFiles_Click" 
                            Style="{StaticResource FluentButtonStyle}" Margin="0,2,8,2"
                            ToolTip="Chọn một hoặc nhiều tệp tin riêng lẻ"/>

                    <!-- Rename View Specific Actions -->
                    <StackPanel x:Name="PanelRenameActions" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Primary Commit Button -->
                        <Button x:Name="BtnApply" Content="▶ Bắt Đầu Đổi Tên" Click="BtnApply_Click" 
                                Style="{StaticResource PrimaryAccentButtonStyle}" Margin="0,2,6,2"
                                ToolTip="Áp dụng quy tắc và đổi tên hàng loạt trên đĩa cứng"/>

                        <!-- Rollback Button -->
                        <Button x:Name="BtnRollback" Content="↩ Hoàn Tác" Click="BtnRollback_Click" 
                                Style="{StaticResource FluentButtonStyle}" Margin="0,2,6,2"
                                ToolTip="Hoàn tác lần đổi tên gần nhất về tên ban đầu"/>

                        <!-- Export CSV Button -->
                        <Button Content="📊 Xuất CSV" Click="BtnExportCsv_Click" 
                                Style="{StaticResource FluentButtonStyle}" Foreground="#10B981" Margin="0,2,8,2"
                                ToolTip="Xuất danh sách báo cáo đổi tên ra định dạng CSV"/>
                    </StackPanel>

                   

                    <Button Content="🗑" Click="BtnClear_Click" ToolTip="Xóa sạch danh sách hiện tại"
                            Style="{StaticResource FluentButtonStyle}" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,2,0,2" Padding="8,7"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: SUB-TOOLBAR / PATH OMNIBAR                        -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeBgSubHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="20,7">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="📁" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Vị trí đang làm việc:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnCloseFolder" Content="✕ Đóng thư mục" Click="BtnCloseFolder_Click" Visibility="Collapsed"
                        DockPanel.Dock="Right" Style="{StaticResource FluentButtonStyle}" Foreground="#F87171" BorderThickness="0" Padding="8,4" FontSize="11" Margin="6,0,0,0" ToolTip="Bỏ chọn thư mục này"/>

                <Button x:Name="BtnOpenExplorer" Content="↗ Mở trong Explorer" Click="BtnOpenExplorer_Click" Visibility="Collapsed"
                        DockPanel.Dock="Right" Style="{StaticResource FluentButtonStyle}" Foreground="#818CF8" BorderThickness="0" Padding="8,4" FontSize="11" Margin="6,0,0,0" ToolTip="Mở thư mục này trực tiếp trong Windows Explorer"/>

                <!-- Path Pill -->
                <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtCurrentFolder" Text="Chưa chọn thư mục (Bấm 'Chọn Thư Mục' hoặc 'Chọn Tệp Tin' để bắt đầu)" 
                               Foreground="#818CF8" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: MAIN WORKSPACE 1: RENAME MODE                     -->
        <!-- ======================================================== -->
        <Grid x:Name="ViewRename" Grid.Row="2" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: RULES & PERFORMANCE MONITOR -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgSidebar}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- CARD 1: PHẠM VI QUÉT & ĐỐI TƯỢNG -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource ThemeBadgeBg}" Margin="0,0,8,0">
                                        <TextBlock Text="⚙️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="PHẠM VI QUÉT &amp; ĐỐI TƯỢNG" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <CheckBox x:Name="ChkRecursive" Content="Quét sâu vào thư mục con" IsChecked="True" Checked="OnOptionChanged" Unchecked="OnOptionChanged" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Duyệt đệ quy tất cả tệp trong các cấp folder bên trong" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,0,0,8" TextWrapping="Wrap"/>
                                <CheckBox x:Name="ChkFolders" Content="Đổi tên cả thư mục (Folder)" IsChecked="True" Checked="OnOptionChanged" Unchecked="OnOptionChanged" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Áp dụng quy tắc đổi tên cho cả thư mục" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,0,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="ChkHidden" Content="Bao gồm cả tệp &amp; thư mục ẩn" IsChecked="False" Checked="OnOptionChanged" Unchecked="OnOptionChanged" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Không bỏ sót các file hệ thống hoặc file bị ẩn" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,0,0,8" TextWrapping="Wrap"/>
                               
                            </StackPanel>
                        </Border>

                        <!-- RULE TABS SELECTOR (Modern Segmented 4-Tab Control) -->
                        <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="1" Margin="0,0,0,6">
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="TabClean" Content="Chuẩn Hóa" IsChecked="True" Checked="OnTabChanged" 
                                             Style="{StaticResource SegmentedRadioButtonStyle}"/>
                                <RadioButton x:Name="TabFind" Content="Tìm &amp; Thay" Checked="OnTabChanged" 
                                             Style="{StaticResource SegmentedRadioButtonStyle}"/>
                                <RadioButton x:Name="TabNum" Content="Đánh Số" Checked="OnTabChanged" 
                                             Style="{StaticResource SegmentedRadioButtonStyle}"/>
                                <RadioButton x:Name="TabCase" Content="Chữ &amp; Đuôi" Checked="OnTabChanged" 
                                             Style="{StaticResource SegmentedRadioButtonStyle}"/>
                            </UniformGrid>
                        </Border>

                        <!-- TAB 1: CHUẨN HÓA & TIẾNG VIỆT -->
                        <StackPanel x:Name="PanelClean" Visibility="Visible">
                            <!-- Xóa dấu tiếng Việt -->
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkVietnamese" Content="Xóa Dấu Tiếng Việt" IsChecked="True" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Chuẩn hóa NFD/NFC, Đ/đ → D/d (Chuẩn Unicode)" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Khoảng trắng -->
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSpace" Content="Xử Lý Khoảng Trắng" IsChecked="True" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Tùy chọn xử lý khoảng cách tên tệp" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,8"/>
                                    <StackPanel Margin="28,0,0,0">
                                        <RadioButton x:Name="RadSpaceCollapse" GroupName="SpaceGroup" Content="Dồn nhiều khoảng trắng → 1" IsChecked="True" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadSpaceTrim" GroupName="SpaceGroup" Content="Cắt bỏ khoảng trắng 2 đầu" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadSpaceRemoveAll" GroupName="SpaceGroup" Content="Xóa tất cả khoảng trắng" Checked="OnRuleChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Ký tự cấm OS -->
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSanitize" Content="Làm Sạch Ký Tự Cấm OS" IsChecked="True" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Loại bỏ \ / : * ? &quot; &lt; &gt; | an toàn Windows" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,8"/>
                                    <DockPanel Margin="28,0,0,0">
                                        <TextBlock Text="Thay bằng:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtSanitizeReplacement" Text="_" MaxLength="2" Width="44" HorizontalAlignment="Left" TextChanged="OnRuleChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Web Slug -->
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSlug" Content="Chuẩn Hóa Web Slug" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Chữ thường, an toàn cho URL web &amp; hosting" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,8"/>
                                    <StackPanel Margin="28,0,0,0" Orientation="Horizontal">
                                        <RadioButton x:Name="RadSlugHyphen" GroupName="SlugGroup" Content="Gạch ngang (-)" IsChecked="True" Checked="OnRuleChanged" Margin="0,0,14,0"/>
                                        <RadioButton x:Name="RadSlugUnderscore" GroupName="SlugGroup" Content="Gạch dưới (_)" Checked="OnRuleChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- MAX_PATH Safe Truncate -->
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkTruncateLongPath" Content="Co Gọn Full Path An Toàn (MAX_PATH)" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Cắt giảm tên file nếu Full Path &gt; 250 ký tự" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,8"/>
                                    <DockPanel Margin="28,0,0,8">
                                        <TextBlock Text="Giới hạn tối đa:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtMaxPathLength" Text="250" Width="55" HorizontalAlignment="Left" TextChanged="OnRuleChanged"/>
                                        <TextBlock Text="ký tự" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </DockPanel>
                                    <StackPanel Margin="28,0,0,0">
                                        <RadioButton x:Name="RadTruncMiddle" GroupName="TruncGroup" Content="Cắt giữa giữ đầu &amp; đuôi (...)" IsChecked="True" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadTruncEnd" GroupName="TruncGroup" Content="Cắt ở cuối tên file" Checked="OnRuleChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 2: TÌM KIẾM VÀ THAY THẾ -->
                        <StackPanel x:Name="PanelFind" Visibility="Collapsed">
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkFindReplace" Content="Bật Tìm &amp; Thay Thế" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Tìm từ khóa hoặc biểu thức Regex" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,10"/>
                                    
                                    <TextBlock Text="Tìm kiếm (Find):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFind" Margin="0,0,0,8" TextChanged="OnRuleChanged"/>

                                    <TextBlock Text="Thay bằng (Replace):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtReplace" Margin="0,0,0,10" TextChanged="OnRuleChanged"/>

                                    <CheckBox x:Name="ChkFindRegex" Content="Sử dụng Regex (Biểu thức chính quy)" IsChecked="False" Margin="0,0,0,6" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <CheckBox x:Name="ChkFindMatchCase" Content="Phân biệt chữ HOA / thường" IsChecked="False" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: TIỀN TỐ/HẬU TỐ & ĐÁNH SỐ THỨ TỰ -->
                        <StackPanel x:Name="PanelNum" Visibility="Collapsed">
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkPrefixSuffix" Content="Thêm Tiền Tố &amp; Hậu Tố" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Chèn chuỗi vào đầu hoặc cuối tên" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,8"/>

                                    <TextBlock Text="Tiền tố (Prefix):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPrefix" Margin="0,0,0,8" TextChanged="OnRuleChanged"/>

                                    <TextBlock Text="Hậu tố (Suffix):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSuffix" TextChanged="OnRuleChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkNumbering" Content="Đánh Số Thứ Tự (001, 002...)" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Tự động tăng số tuần tự cho từng file" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Bắt đầu:" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                            <TextBox x:Name="TxtNumStart" Text="1" TextChanged="OnRuleChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                            <TextBlock Text="Bước:" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                            <TextBox x:Name="TxtNumStep" Text="1" TextChanged="OnRuleChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Chữ số:" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                            <TextBox x:Name="TxtNumPad" Text="3" TextChanged="OnRuleChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Vị trí chèn số:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <StackPanel Margin="0,0,0,8">
                                        <RadioButton x:Name="RadNumSuffix" GroupName="NumPos" Content="Cuối tên (vd: Anh_001)" IsChecked="True" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadNumPrefix" GroupName="NumPos" Content="Đầu tên (vd: 001_Anh)" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadNumReplace" GroupName="NumPos" Content="Thay thế hoàn toàn bằng số" Checked="OnRuleChanged"/>
                                    </StackPanel>

                                    <TextBlock Text="Ký tự nối / Ngăn cách:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNumSep" Text="_" TextChanged="OnRuleChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 4: KIỂU CHỮ & ĐUÔI MỞ RỘNG -->
                        <StackPanel x:Name="PanelCase" Visibility="Collapsed">
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCase" Content="Đổi Kiểu Chữ Hoa / Thường" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Biến đổi định dạng chữ" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,8"/>
                                    <StackPanel Margin="28,0,0,0">
                                        <RadioButton x:Name="RadCaseTitle" GroupName="CaseGroup" Content="Title Case (Viết Hoa Chữ Đầu Từ)" IsChecked="True" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadCaseSentence" GroupName="CaseGroup" Content="Sentence case (Viết hoa đầu câu)" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadCaseUpper" GroupName="CaseGroup" Content="UPPERCASE (VIẾT HOA TOÀN BỘ)" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadCaseLower" GroupName="CaseGroup" Content="lowercase (viết thường toàn bộ)" Checked="OnRuleChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkChangeExt" Content="Đổi Đuôi Mở Rộng" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Thay đổi hoặc chuẩn hóa phần extension" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="28,2,0,8"/>
                                    <DockPanel Margin="28,0,0,0">
                                        <TextBlock Text="Đuôi mới:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtNewExt" Text="png" TextChanged="OnRuleChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT TABLE AREA -->
            <Grid Grid.Column="1" Background="{DynamicResource ThemeBgMainContent}" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search & Status Filter Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box with Icon -->
                        <Border Grid.Column="0" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="7" Padding="8,2">
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtSearch" TextChanged="OnSearchChanged" FontSize="11" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource ThemeTextPrimary}" ToolTip="Tìm kiếm theo tên file ban đầu hoặc tên mới"/>
                            </DockPanel>
                        </Border>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="RadFilterAll" Content="Tất cả" IsChecked="True" Checked="OnFilterChanged"
                                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
                            <RadioButton x:Name="RadFilterRenamed" Content="✔ Đã đổi" Checked="OnFilterChanged"
                                         Style="{StaticResource FilterChipRadioButtonStyle}" Foreground="#10B981"/>
                            <RadioButton x:Name="RadFilterUnchanged" Content="Giữ nguyên" Checked="OnFilterChanged"
                                         Style="{StaticResource FilterChipRadioButtonStyle}"/>
                            <RadioButton x:Name="RadFilterCollision" Content="⚡ Xung đột" Checked="OnFilterChanged"
                                         Style="{StaticResource FilterChipRadioButtonStyle}" Foreground="#F59E0B"/>
                            <RadioButton x:Name="RadFilterLongPath" Content="⚠️ Dài &gt; 250" Checked="OnFilterChanged"
                                         Style="{StaticResource FilterChipRadioButtonStyle}" Foreground="#EF4444"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status & Warning Banners -->
                <StackPanel Grid.Row="1">
                    <!-- Long Path Warning Alert Banner with 1-click Auto Fix -->
                    <Border x:Name="BannerLongPath" Background="#260505" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Cảnh báo: " Foreground="#F87171" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Phát hiện " Foreground="#FCA5A5" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLongPathCount" Text="0 tệp" Foreground="#FEF08A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text=" có Full Path vượt quá giới hạn an toàn (&gt; 250 ký tự)!" Foreground="#FCA5A5" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="⚡ Tự Động Co Gọn An Toàn (Smart Truncate)" Click="BtnAutoTruncate_Click"
                                    Style="{StaticResource DangerAccentButtonStyle}" HorizontalAlignment="Right" Padding="12,6"/>
                        </Grid>
                    </Border>

                    <!-- Status Banner / Notification -->
                    <Border x:Name="BannerMessage" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="TxtBanner" Text="Thông báo trạng thái" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="✕" Click="BtnCloseBanner_Click" Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Padding="4"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- DataGrid & Loading Overlay -->
                <Border Grid.Row="2" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <!-- Empty State / Dropzone khi chưa chọn file -->
                        <Border x:Name="PanelEmptyState" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="84" Height="84" CornerRadius="24" Background="{DynamicResource ThemeBadgeBg}" BorderBrush="{DynamicResource ThemeBadgeBorder}" BorderThickness="1.5" Margin="0,0,0,16" HorizontalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Kéo thả thư mục hoặc tệp tin vào đây" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Hỗ trợ chuẩn hóa tiếng Việt, xử lý đường dẫn dài MAX_PATH và nén ảnh WIC siêu tốc" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="📂 Chọn Thư Mục" Click="BtnScanFolder_Click" Style="{StaticResource PrimaryAccentButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="📄 Chọn Tệp Tin" Click="BtnSelectFiles_Click" Style="{StaticResource FluentButtonStyle}" Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="GridFiles" AutoGenerateColumns="False" CanUserAddRows="False" Visibility="Collapsed"
                                  Background="Transparent" RowBackground="{DynamicResource ThemeGridRowBg}" AlternatingRowBackground="{DynamicResource ThemeGridRowAltBg}"
                                  Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource ThemeGridLines}" HeadersVisibility="Column"
                                  SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" FontSize="12" RowHeight="36">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{DynamicResource ThemeGridHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                </Style>

                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tên Ban Đầu" Binding="{Binding OriginalName}" Width="2*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tên Mới Dự Kiến" Binding="{Binding NewName}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="#818CF8"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Độ Dài Path" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullPathLength}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border CornerRadius="4" Padding="5,2" Visibility="{Binding IsLongPath, Converter={StaticResource BoolToVis}}" Background="#7F1D1D">
                                                    <TextBlock Text="⚠️ Quá dài" Foreground="#FCA5A5" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trạng Thái" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="ready">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeBadgeBg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="renamed">
                                                                <Setter Property="Background" Value="#064E3B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="unchanged">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeTabActiveBg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="collision_resolved">
                                                                <Setter Property="Background" Value="#451A03"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="ready">
                                                                    <Setter Property="Text" Value="Sẵn sàng"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeBadgeText}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="renamed">
                                                                    <Setter Property="Text" Value="✔ Đã đổi"/>
                                                                    <Setter Property="Foreground" Value="#34D399"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="unchanged">
                                                                    <Setter Property="Text" Value="Giữ nguyên"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="collision_resolved">
                                                                    <Setter Property="Text" Value="Trùng: _1"/>
                                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Thao Tác" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📂" ToolTip="Mở trong Windows Explorer" Click="BtnOpenFile_Click"
                                                    Style="{StaticResource FluentButtonStyle}" Padding="6,3" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Loading Overlay khi quét thư mục -->
                        <Border x:Name="PanelGridLoading" Background="{DynamicResource ThemeGridOverlay}" CornerRadius="10" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="300" Height="6" Background="{DynamicResource ThemeBorder}" Foreground="{DynamicResource ThemeAccent}" BorderThickness="0" Margin="0,0,0,16">
                                    <ProgressBar.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                                <TextBlock x:Name="TxtGridLoadingTitle" Text="Đang xử lý &amp; tải hiển thị danh sách..." Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtGridLoadingDesc" Text="Vui lòng chờ trong giây lát..." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" MaxWidth="550" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtGridSkipped" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <Button x:Name="BtnCancelScan" Content="✕ Dừng Quét" Click="BtnCancelScan_Click"
                                        Style="{StaticResource DangerAccentButtonStyle}" Margin="0,14,0,0" HorizontalAlignment="Center" ToolTip="Dừng quá trình quét ngay lập tức và giữ lại các tệp đã tìm thấy"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 2: MAIN WORKSPACE 2: IMAGE RESIZER MODE              -->
        <!-- ======================================================== -->
        <Grid x:Name="ViewImageResizer" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: IMAGE OPTIONS -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgSidebar}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- PRESETS -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource ThemeBadgeBg}" Margin="0,0,8,0">
                                        <TextBlock Text="📐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="KÍCH THƯỚC ĐỊNH SẴN (PRESETS)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <RadioButton x:Name="RadPreset4K" GroupName="PresetGroup" Content="4K UHD (3840 × 2160)" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPreset2K" GroupName="PresetGroup" Content="2K QHD (2560 × 1440)" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPresetFHD" GroupName="PresetGroup" Content="FHD 1080p (1920 × 1080)" IsChecked="True" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPreset1360" GroupName="PresetGroup" Content="Laptop HD (1360 × 768)" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPresetHD" GroupName="PresetGroup" Content="HD 720p (1280 × 720)" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPresetWeb" GroupName="PresetGroup" Content="Web Chuẩn (1024 × 768)" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPresetCustom" GroupName="PresetGroup" Content="Tùy chỉnh (Custom)" Checked="OnPresetChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- TARGET RESOLUTION -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource ThemeBadgeBg}" Margin="0,0,8,0">
                                        <TextBlock Text="🎯" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ĐỘ PHÂN GIẢI MỤC TIÊU" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Rộng max (px):" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtImgMaxWidth" Text="1920" TextChanged="OnImageOptionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Cao max (px):" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtImgMaxHeight" Text="1080" TextChanged="OnImageOptionChanged"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ChkImgKeepAspect" Content="Giữ nguyên tỷ lệ khung hình" IsChecked="True" FontWeight="SemiBold" Checked="OnImageOptionChanged" Unchecked="OnImageOptionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- QUALITY SLIDER -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource ThemeBadgeBg}" Margin="0,0,8,0">
                                            <TextBlock Text="🎨" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="CHẤT LƯỢNG NÉN:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource ThemeBadgeBg}" BorderBrush="{DynamicResource ThemeBadgeBorder}" BorderThickness="1" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtImgQualityVal" Text="80%" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                    </Border>
                                </DockPanel>
                                <Slider x:Name="SliderImgQuality" Minimum="10" Maximum="100" Value="80" SmallChange="5" LargeChange="10" 
                                        ValueChanged="OnImageQualityChanged" Margin="0,4,0,6" Cursor="Hand"/>
                                <TextBlock Text="Khuyến nghị 75% - 85% cho chất lượng tối ưu" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                            </StackPanel>
                        </Border>

                        <!-- OUTPUT FORMAT -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource ThemeBadgeBg}" Margin="0,0,8,0">
                                        <TextBlock Text="🔄" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ĐỊNH DẠNG XUẤT" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <RadioButton x:Name="RadImgFmtOriginal" GroupName="ImgFmtGroup" Content="Giữ định dạng gốc" IsChecked="True" Checked="OnImageOptionChanged"/>
                                <RadioButton x:Name="RadImgFmtJpeg" GroupName="ImgFmtGroup" Content="Chuyển sang JPEG (.jpg) — Nén tốt nhất" Checked="OnImageOptionChanged"/>
                                <RadioButton x:Name="RadImgFmtPng" GroupName="ImgFmtGroup" Content="Chuyển sang PNG (.png)" Checked="OnImageOptionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- OVERWRITE & SAFETY NOTICE CARD -->
                        <Border Background="#260505" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🛡️ " FontSize="12"/>
                                    <TextBlock Text="BẢO VỆ GHI ĐÈ AN TOÀN 2 LỚP" FontWeight="Bold" FontSize="11" Foreground="#F87171"/>
                                </StackPanel>
                                <TextBlock Text="• Tự động BỎ QUA nếu ảnh ban đầu đã nhỏ hơn mục tiêu (tránh phóng to/upscale)." Foreground="#FECACA" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="• Tự động HỦY nếu kích thước sau nén lớn hơn bản gốc." Foreground="#FECACA" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="• Ghi đè tệp tạm nguyên tử (atomic), bảo vệ an toàn tối đa cho tệp gốc." Foreground="#FECACA" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT WORKSPACE: IMAGE LIST -->
            <Grid Grid.Column="1" Background="{DynamicResource ThemeBgMainContent}" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: Selection Chips, Search & Overwrite Action -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selection Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Content="Tất cả" Click="BtnImgSelectAll_Click" Style="{StaticResource FluentButtonStyle}" Padding="8,4" Margin="0,0,4,0"/>
                            <Button Content="Bỏ chọn" Click="BtnImgDeselectAll_Click" Style="{StaticResource FluentButtonStyle}" Padding="8,4" Margin="0,0,4,0"/>
                            <Button Content="&gt; 2 MB" Click="BtnImgSelectLargeSize_Click" Style="{StaticResource FluentButtonStyle}" Foreground="#F59E0B" Padding="8,4" Margin="0,0,4,0"/>
                            <Button Content="&gt; 1920 px" Click="BtnImgSelectLargeDim_Click" Style="{StaticResource FluentButtonStyle}" Foreground="#818CF8" Padding="8,4" Margin="0,0,4,0"/>
                            <Button Content="⚡ Chỉ ảnh &gt; mục tiêu" Click="BtnImgSelectOverTarget_Click" Style="{StaticResource PrimaryAccentButtonStyle}" Padding="10,4" ToolTip="Tự động chỉ tích chọn các ảnh có kích thước lớn hơn kích thước mục tiêu đã chọn"/>
                        </StackPanel>

                        <!-- Search Box -->
                        <Border Grid.Column="1" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="7" Padding="8,2">
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtImgSearch" TextChanged="OnImgSearchChanged" FontSize="11" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource ThemeTextPrimary}" ToolTip="Tìm kiếm theo tên file ảnh"/>
                            </DockPanel>
                        </Border>

                        <!-- Execute Overwrite Action Button -->
                        <Button x:Name="BtnExecuteOverwrite" Grid.Column="2" Content="⚡ Tiến Hành Ghi Đè (0 ảnh)" Click="BtnExecuteOverwrite_Click"
                                Style="{StaticResource DangerAccentButtonStyle}" HorizontalAlignment="Right" Padding="16,8"/>
                    </Grid>
                </Border>

                <!-- DataGrid for Images -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10">
                    <DataGrid x:Name="GridImages" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" RowBackground="{DynamicResource ThemeGridRowBg}" AlternatingRowBackground="{DynamicResource ThemeGridRowAltBg}"
                              Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource ThemeGridLines}" HeadersVisibility="Column"
                              SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" FontSize="12" RowHeight="36">

                        <DataGrid.Resources>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="{DynamicResource ThemeGridHeaderBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                            </Style>

                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Checkbox Select -->
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ChkImgHeaderAll" Checked="OnImgHeaderCheckAll" Unchecked="OnImgHeaderUncheckAll" HorizontalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="OnImgItemSelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Index -->
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" IsReadOnly="True"/>

                            <!-- File Name -->
                            <DataGridTextColumn Header="Tên Tệp Ảnh" Binding="{Binding FileName}" Width="2*" IsReadOnly="True"/>

                            <!-- Original Dimensions -->
                            <DataGridTextColumn Header="Kích Thước Gốc" Binding="{Binding OriginalDimensions}" Width="120" IsReadOnly="True"/>

                            <!-- Target Dimensions -->
                            <DataGridTemplateColumn Header="Kích Thước Mới" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TargetDimensionsDisplay}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#818CF8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlreadySmaller}" Value="True">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Original Size -->
                            <DataGridTextColumn Header="Dung Lượng Gốc" Binding="{Binding OriginalSizeFormatted}" Width="110" IsReadOnly="True"/>

                            <!-- New Size -->
                            <DataGridTextColumn Header="Dung Lượng Mới" Binding="{Binding NewSizeFormatted}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="#34D399"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="ready">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeBadgeBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="success">
                                                            <Setter Property="Background" Value="#064E3B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="skipped_smaller">
                                                            <Setter Property="Background" Value="#451A03"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="skipped_larger">
                                                            <Setter Property="Background" Value="#451A03"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="error">
                                                            <Setter Property="Background" Value="#450A0A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="ready">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeBadgeText}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="success">
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="skipped_smaller">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="skipped_larger">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="error">
                                                                <Setter Property="Foreground" Value="#F87171"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Thao Tác" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📂" ToolTip="Mở trong File Explorer" Click="BtnOpenImageInExplorer_Click"
                                                Style="{StaticResource FluentButtonStyle}" Padding="6,3" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- ROW 3: FOOTER BAR / STATUS BAR                           -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeBgFooter}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status & Item Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 " FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtItemCount" Text="Sẵn sàng: 0 tệp tin" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Live Telemetry & Performance Monitor (Nổi Bật Sắc Nét) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="12" Padding="12,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Telemetry Title Tag -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="⚡" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="HIỆU NĂNG LIVE" FontWeight="Bold" FontSize="10" Foreground="#818CF8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Metric 1: Elapsed Calculation Time -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Thời gian tính toán quy tắc đổi tên tệp">
                                <TextBlock Text="⏱ " FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="Thời gian: " FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBenchTime" Text="0.00 ms" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Width="1" Height="12" Background="{DynamicResource ThemeBorderStrong}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <!-- Metric 2: Throughput -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Tốc độ xử lý tính toán số tệp trên mỗi giây">
                                <TextBlock Text="🚀 " FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="Thông lượng: " FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBenchThroughput" Text="0 tệp/giây" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Width="1" Height="12" Background="{DynamicResource ThemeBorderStrong}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <!-- Metric 3: CPU Multi-threading -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Số luồng xử lý song song đa nhân của CPU">
                                <TextBlock Text="💻 " FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBenchThreads" Text="8 Threads" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Platform Info & GitHub Quick Link -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="C# .NET 11 • WPF Native • " FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="GitHub Repository" FontSize="11" FontWeight="SemiBold" Foreground="#818CF8" Cursor="Hand" TextDecorations="Underline" MouseDown="TxtGitHubLink_MouseDown" ToolTip="Bấm để mở giới thiệu &amp; kho mã nguồn trên GitHub" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- CONFIRM OVERWRITE MODAL DIALOG                           -->
        <!-- ======================================================== -->
        <Border x:Name="ModalConfirmOverwrite" Grid.RowSpan="4" Background="#E6020617" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="#EF4444" BorderThickness="2" CornerRadius="14" 
                    Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#7F1D1D" Margin="0,0,14,0">
                            <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="XÁC NHẬN GHI ĐÈ TRỰC TIẾP LÊN ẢNH GỐC" FontWeight="Bold" FontSize="15" Foreground="#EF4444"/>
                            <TextBlock Text="Hành động này sẽ thay đổi kích thước và dung lượng tệp vĩnh viễn trên đĩa" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#350606" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <TextBlock Text="CẢNH BÁO AN TOÀN: Kích thước và dung lượng ảnh sẽ được nén và ghi đè trực tiếp lên file gốc. Dữ liệu gốc sẽ KHÔNG THỂ KHÔI PHỤC sau khi hoàn tất. Vui lòng đảm bảo bạn đã có bản sao lưu nếu cần thiết."
                                   Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
                    </Border>

                    <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <TextBlock Text="Số lượng ảnh được chọn ghi đè:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalCount" Text="0 tệp" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Số ảnh tự động giữ nguyên (đã nhỏ hơn):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalSkipped" Text="0 tệp" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Kích thước mục tiêu:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalTargetDim" Text="Max 1920 × 1080 px" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Chất lượng nén:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalQuality" Text="80%" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Định dạng xuất:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalFormat" Text="Giữ định dạng gốc" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkAgreeOverwrite" Content="Tôi đã kiểm tra kỹ danh sách và đồng ý ghi đè trực tiếp" 
                              FontWeight="Bold" Foreground="#FEF08A" Margin="0,0,0,18" Checked="OnAgreeOverwriteChanged" Unchecked="OnAgreeOverwriteChanged"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="✕ Hủy Bỏ" Click="BtnCancelOverwrite_Click"
                                Style="{StaticResource FluentButtonStyle}" Padding="14,9" Margin="0,0,6,0"/>
                        <Button x:Name="BtnConfirmOverwriteExecute" Grid.Column="1" Content="⚡ Tiến Hành Ghi Đè Ngay" Click="BtnConfirmOverwriteExecute_Click"
                                Style="{StaticResource DangerAccentButtonStyle}" IsEnabled="False" Padding="14,9" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================================================== -->
        <!-- ABOUT & UPDATE MODAL DIALOG                              -->
        <!-- ======================================================== -->
        <Border x:Name="ModalAbout" Grid.RowSpan="4" Background="#E6020617" Visibility="Collapsed" Panel.ZIndex="101">
            <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1.5" CornerRadius="16" 
                    Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                <StackPanel>
                    <!-- Header with App Logo -->
                    <DockPanel Margin="0,0,0,16">
                        <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0" DockPanel.Dock="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="✕" Click="BtnCloseAbout_Click" Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" 
                                FontSize="14" Cursor="Hand" DockPanel.Dock="Right" VerticalAlignment="Top" Padding="4"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Rename File Viet" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                <Border Background="{DynamicResource ThemeBadgeBg}" BorderBrush="{DynamicResource ThemeBadgeBorder}" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.0.0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeBadgeText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Tiện ích đổi tên tệp tiếng Việt &amp; nén ảnh hàng loạt cao cấp" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Info Card -->
                    <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <TextBlock Text="Tác giả (Developer):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock Text="Nguyễn Đức Tài (nguyenductai1983)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Giấy phép / Bản quyền:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock Text="MIT License (Mã nguồn mở miễn phí)" FontWeight="Bold" FontSize="11" Foreground="#34D399" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Nền tảng công nghệ:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock Text="C# (.NET 11) • WPF Windows Native" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Update Section -->
                    <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🚀" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="TẢI BẢN CẬP NHẬT &amp; THEO DÕI DỰ ÁN" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                            </StackPanel>
                            <TextBlock Text="Dự án được cập nhật thường xuyên trên GitHub. Bấm vào nút bên dưới để tải về các bản phát hành mới nhất hoặc xem mã nguồn &amp; đóng góp ý kiến:" 
                                       FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="17"/>

                            <!-- Main Download Button -->
                            <Button Content="🚀 Tải Bản Cập Nhật Mới Nhất (GitHub Releases)" Click="BtnDownloadUpdate_Click"
                                    Style="{StaticResource PrimaryAccentButtonStyle}" Margin="0,0,0,10" Padding="16,10"/>

                            <!-- Secondary Links Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⭐ Xem Mã Nguồn GitHub" Click="BtnGitHub_Click"
                                        Style="{StaticResource FluentButtonStyle}" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="🐞 Báo Lỗi / Góp Ý" Click="BtnGitHubIssues_Click"
                                        Style="{StaticResource FluentButtonStyle}" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button Content="Đóng" Click="BtnCloseAbout_Click"
                            Style="{StaticResource FluentButtonStyle}" HorizontalAlignment="Right" Width="100"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ======================================================== -->
        <!-- IMAGE PROCESSING PROGRESS OVERLAY                        -->
        <!-- ======================================================== -->
        <Border x:Name="PanelImageProgress" Grid.RowSpan="4" Background="#E6020617" Visibility="Collapsed" Panel.ZIndex="99">
            <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="14"
                    Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="TxtImgProgressTitle" Text="Đang xử lý nén &amp; giảm kích thước ảnh..." 
                               FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <ProgressBar x:Name="ProgressImgBar" Minimum="0" Maximum="100" Height="8" Background="{DynamicResource ThemeBorder}" Foreground="#EF4444" BorderThickness="0" Margin="0,0,0,12">
                        <ProgressBar.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                    <TextBlock x:Name="TxtImgProgressFile" Text="IMG_001.JPG" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,18" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                    <Button x:Name="BtnCancelImageResize" Content="✕ Dừng Xử Lý" Click="BtnCancelImageResize_Click"
                            Style="{StaticResource DangerAccentButtonStyle}" Padding="16,7" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
