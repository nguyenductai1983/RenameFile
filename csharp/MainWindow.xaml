<Window x:Class="CSharpFileRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rename File Viet (C# .NET 11 Edition)" 
        Height="780" Width="1200" 
        MinHeight="600" MinWidth="950"
        Background="{DynamicResource ThemeBgWindow}" Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI, Inter, Arial"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Controls styling with DynamicResource for automatic Windows Theme adaptation -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeBgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#4F46E5" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Rename File Viet" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeTextPrimary}"/>
                        <TextBlock Text="Tiện ích đổi tên tệp tiếng Việt &amp; nén ảnh (.NET 11)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Mode Switcher (Chuyển chế độ: Đổi tên / Giảm dung lượng ảnh) -->
                <Border Grid.Column="1" Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="12,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RadModeRename" Content="🏷️ Đổi Tên Tệp" IsChecked="True" Checked="OnModeChanged"
                                     Style="{x:Null}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" FontSize="11" 
                                     Padding="12,6" Cursor="Hand"/>
                        <RadioButton x:Name="RadModeImage" Content="🖼️ Giảm Kích Thước Ảnh (0)" Checked="OnModeChanged"
                                     Style="{x:Null}" Foreground="{DynamicResource ThemeTextSecondary}" FontWeight="SemiBold" FontSize="11" 
                                     Padding="12,6" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Actions: WrapPanel ensures buttons wrap instead of getting clipped when window shrinks -->
                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Scan Folder Button (Màu Vàng Cam Amber đặc trưng cho Thư mục) -->
                    <Button Content="📂 Quét Thư Mục" Click="BtnScanFolder_Click" 
                            Background="#D97706" Foreground="White" BorderBrush="#F59E0B" BorderThickness="1"
                            FontWeight="SemiBold" FontSize="12" Padding="14,7" Margin="0,2,8,2" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Select Files Button (Màu Xanh Tím Indigo đặc trưng cho Tệp tin) -->
                    <Button Content="📄 Chọn Files" Click="BtnSelectFiles_Click" 
                            Background="#4F46E5" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="12" Padding="14,7" Margin="0,2,8,2" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Rename View Specific Actions -->
                    <StackPanel x:Name="PanelRenameActions" Orientation="Horizontal">
                        <!-- Commit Rename Button -->
                        <Button x:Name="BtnApply" Content="▶ Đổi Tên" Click="BtnApply_Click" 
                                Background="#059669" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="12" Padding="14,7" Margin="0,2,8,2" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Rollback Button -->
                        <Button x:Name="BtnRollback" Content="↩ Undo" Click="BtnRollback_Click" 
                                Background="{DynamicResource ThemeBgCardAlt}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="12,7" Margin="0,2,8,2" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Export CSV Button -->
                        <Button Content="📊 CSV" Click="BtnExportCsv_Click" 
                                Background="{DynamicResource ThemeBgCardAlt}" Foreground="#10B981" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="10,7" Margin="0,2,8,2" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Theme Toggle Button (Đồng bộ Dark / Light theo Windows) -->
                    <Button x:Name="BtnThemeToggle" Content="🌓 Theo Windows" Click="BtnThemeToggle_Click" 
                            Background="{DynamicResource ThemeBgCardAlt}" Foreground="{DynamicResource ThemeTextSecondary}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                            FontWeight="SemiBold" FontSize="11" Padding="10,7" Margin="0,2,8,2" Cursor="Hand"
                            ToolTip="Chuyển chế độ: Theo Windows / Chế độ Tối / Chế độ Sáng">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Clear Button -->
                    <Button Content="🗑" Click="BtnClear_Click" ToolTip="Xóa danh sách"
                            Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0"
                            FontSize="14" Padding="8,4" Margin="0,2,0,2" Cursor="Hand"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- SUB-TOOLBAR: CURRENT SELECTED FOLDER -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeBgSubHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="20,8">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="📁 Thư mục hiện tại:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" MaxWidth="700">
                    <TextBlock x:Name="TxtCurrentFolder" Text="Chưa chọn thư mục (Bấm 'Quét Thư Mục' hoặc 'Chọn Files')" 
                               Foreground="#818CF8" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="BtnOpenExplorer" Content="↗ Explorer" Click="BtnOpenExplorer_Click" Visibility="Collapsed"
                        Background="Transparent" Foreground="#818CF8" BorderThickness="0" FontSize="11" Cursor="Hand" Margin="0,0,8,0" ToolTip="Mở thư mục này trong Windows Explorer"/>
                <Button x:Name="BtnCloseFolder" Content="✕ Đóng" Click="BtnCloseFolder_Click" Visibility="Collapsed"
                        Background="Transparent" Foreground="#F87171" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="Bỏ chọn thư mục"/>
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN WORKSPACE 1: RENAME MODE             -->
        <!-- ========================================== -->
        <Grid x:Name="ViewRename" Grid.Row="2" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: RULES & BENCHMARK -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgSidebar}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- BẢNG PHẠM VI QUÉT & ĐỐI TƯỢNG -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⚙️ PHẠM VI QUÉT &amp; ĐỐI TƯỢNG" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,10"/>
                                
                                <CheckBox x:Name="ChkRecursive" Content="Quét sâu vào thư mục con" IsChecked="True" Checked="OnOptionChanged" Unchecked="OnOptionChanged" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Duyệt đệ quy tất cả file trong các cấp folder bên trong" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,0,0,8" TextWrapping="Wrap"/>

                                <CheckBox x:Name="ChkHidden" Content="Bao gồm cả tệp &amp; thư mục ẩn" IsChecked="False" Checked="OnOptionChanged" Unchecked="OnOptionChanged" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Không bỏ sót các file hệ thống hoặc file bị ẩn" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,0,0,8" TextWrapping="Wrap"/>

                                <CheckBox x:Name="ChkFolders" Content="Đổi tên cả thư mục (Folder)" IsChecked="False" Checked="OnOptionChanged" Unchecked="OnOptionChanged" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="Áp dụng quy tắc đổi tên cho cả folder, không chỉ file" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Tab Selector Buttons -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,14">
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="TabClean" Content="Chuẩn Hóa" IsChecked="True" Checked="OnTabChanged" 
                                             Style="{x:Null}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="SemiBold" 
                                             HorizontalAlignment="Center" Cursor="Hand" Margin="2,4"/>
                                <RadioButton x:Name="TabFind" Content="Tìm &amp; Thay" Checked="OnTabChanged" 
                                             Style="{x:Null}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="SemiBold" 
                                             HorizontalAlignment="Center" Cursor="Hand" Margin="2,4"/>
                                <RadioButton x:Name="TabNum" Content="Đánh Số" Checked="OnTabChanged" 
                                             Style="{x:Null}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="SemiBold" 
                                             HorizontalAlignment="Center" Cursor="Hand" Margin="2,4"/>
                                <RadioButton x:Name="TabCase" Content="Chữ &amp; Đuôi" Checked="OnTabChanged" 
                                             Style="{x:Null}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="SemiBold" 
                                             HorizontalAlignment="Center" Cursor="Hand" Margin="2,4"/>
                            </UniformGrid>
                        </Border>

                        <!-- TAB 1: CHUẨN HÓA & TIẾNG VIỆT -->
                        <StackPanel x:Name="PanelClean" Visibility="Visible">
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkVietnamese" Content="Xóa Dấu Tiếng Việt" IsChecked="True" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Chuẩn hóa NFD/NFC, Đ/đ → D/d" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSpace" Content="Xử Lý Khoảng Trắng" IsChecked="True" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Tùy chọn xử lý khoảng cách tên" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,8"/>
                                    <StackPanel Margin="20,0,0,0">
                                        <RadioButton x:Name="RadSpaceCollapse" GroupName="SpaceGroup" Content="Dồn nhiều khoảng trắng → 1" IsChecked="True" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadSpaceTrim" GroupName="SpaceGroup" Content="Cắt bỏ khoảng trắng 2 đầu" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadSpaceRemoveAll" GroupName="SpaceGroup" Content="Xóa tất cả khoảng trắng" Checked="OnRuleChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSanitize" Content="Làm Sạch Ký Tự Cấm OS" IsChecked="True" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Loại bỏ \ / : * ? &quot; &lt; &gt; |" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,6"/>
                                    <DockPanel Margin="20,2,0,0">
                                        <TextBlock Text="Thay bằng:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtSanitizeReplacement" Text="_" MaxLength="2" Width="40" HorizontalAlignment="Left" TextChanged="OnRuleChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkSlug" Content="Chuẩn Hóa Web Slug" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Chữ thường, an toàn cho URL" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,6"/>
                                    <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                                        <RadioButton x:Name="RadSlugHyphen" GroupName="SlugGroup" Content="Gạch ngang (-)" IsChecked="True" Checked="OnRuleChanged" Margin="0,0,12,0"/>
                                        <RadioButton x:Name="RadSlugUnderscore" GroupName="SlugGroup" Content="Gạch dưới (_)" Checked="OnRuleChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkTruncateLongPath" Content="Co Gọn Full Path An Toàn (MAX_PATH)" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Cắt giảm tên file nếu đường dẫn &gt; 250 ký tự" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,8"/>
                                    <DockPanel Margin="20,0,0,8">
                                        <TextBlock Text="Giới hạn tối đa:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtMaxPathLength" Text="250" Width="50" HorizontalAlignment="Left" TextChanged="OnRuleChanged"/>
                                        <TextBlock Text="ký tự" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </DockPanel>
                                    <StackPanel Margin="20,0,0,0">
                                        <RadioButton x:Name="RadTruncMiddle" GroupName="TruncGroup" Content="Cắt giữa giữ đầu &amp; đuôi (...)" IsChecked="True" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadTruncEnd" GroupName="TruncGroup" Content="Cắt ở cuối tên file" Checked="OnRuleChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 2: TÌM KIẾM VÀ THAY THẾ -->
                        <StackPanel x:Name="PanelFind" Visibility="Collapsed">
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkFindReplace" Content="Bật Tìm &amp; Thay Thế" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Tìm từ khóa hoặc biểu thức Regex" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,10"/>
                                    
                                    <TextBlock Text="Tìm (Find):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFind" Margin="0,0,0,8" TextChanged="OnRuleChanged"/>

                                    <TextBlock Text="Thay bằng (Replace):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtReplace" Margin="0,0,0,10" TextChanged="OnRuleChanged"/>

                                    <CheckBox x:Name="ChkFindRegex" Content="Sử dụng Regex (Biểu thức chính quy)" IsChecked="False" Margin="0,0,0,6" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <CheckBox x:Name="ChkFindMatchCase" Content="Phân biệt chữ HOA / thường" IsChecked="False" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: TIỀN TỐ/HẬU TỐ & ĐÁNH SỐ THỨ TỰ -->
                        <StackPanel x:Name="PanelNum" Visibility="Collapsed">
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkPrefixSuffix" Content="Thêm Tiền Tố &amp; Hậu Tố" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Chèn chuỗi vào đầu hoặc cuối tên" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,8"/>

                                    <TextBlock Text="Tiền tố (Prefix):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPrefix" Margin="0,0,0,8" TextChanged="OnRuleChanged"/>

                                    <TextBlock Text="Hậu tố (Suffix):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSuffix" TextChanged="OnRuleChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkNumbering" Content="Đánh Số Thứ Tự (001, 002...)" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Tự động tăng số tuần tự cho từng file" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Bắt đầu:" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                            <TextBox x:Name="TxtNumStart" Text="1" TextChanged="OnRuleChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                            <TextBlock Text="Bước:" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                            <TextBox x:Name="TxtNumStep" Text="1" TextChanged="OnRuleChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                            <TextBlock Text="Chữ số:" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                            <TextBox x:Name="TxtNumPad" Text="3" TextChanged="OnRuleChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Vị trí chèn:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <StackPanel Margin="0,0,0,8">
                                        <RadioButton x:Name="RadNumSuffix" GroupName="NumPos" Content="Cuối tên (vd: Anh_001)" IsChecked="True" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadNumPrefix" GroupName="NumPos" Content="Đầu tên (vd: 001_Anh)" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadNumReplace" GroupName="NumPos" Content="Thay thế bằng tiền tố + số" Checked="OnRuleChanged"/>
                                    </StackPanel>

                                    <TextBlock Text="Ký tự nối / Tiền tố:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNumSep" Text="_" TextChanged="OnRuleChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 4: KIỂU CHỮ & ĐUÔI MỞ RỘNG -->
                        <StackPanel x:Name="PanelCase" Visibility="Collapsed">
                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCase" Content="Đổi Kiểu Chữ Hoa / Thường" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Biến đổi định dạng chữ" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,8"/>
                                    <StackPanel Margin="20,0,0,0">
                                        <RadioButton x:Name="RadCaseTitle" GroupName="CaseGroup" Content="Title Case (Viết Hoa Chữ Đầu Từ)" IsChecked="True" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadCaseSentence" GroupName="CaseGroup" Content="Sentence case (Viết hoa chữ đầu câu)" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadCaseUpper" GroupName="CaseGroup" Content="UPPERCASE (VIẾT HOA TOÀN BỘ)" Checked="OnRuleChanged"/>
                                        <RadioButton x:Name="RadCaseLower" GroupName="CaseGroup" Content="lowercase (viết thường toàn bộ)" Checked="OnRuleChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkChangeExt" Content="Đổi Đuôi Mở Rộng" IsChecked="False" FontWeight="SemiBold" Checked="OnRuleChanged" Unchecked="OnRuleChanged"/>
                                    <TextBlock Text="Thay đổi hoặc loại bỏ phần đuôi" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="20,2,0,6"/>
                                    <DockPanel Margin="20,2,0,0">
                                        <TextBlock Text="Đuôi mới:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtNewExt" Text="png" TextChanged="OnRuleChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- BENCHMARK LIVE CARD -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="⚡ BENCHMARK HIỆU NĂNG" FontWeight="Bold" FontSize="11" Foreground="#818CF8" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,2">
                                    <TextBlock Text="Thời gian tính:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    <TextBlock x:Name="TxtBenchTime" Text="0.00 ms" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Thông lượng:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    <TextBlock x:Name="TxtBenchThroughput" Text="0 tệp/giây" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,2">
                                    <TextBlock Text="Đa luồng CPU:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    <TextBlock x:Name="TxtBenchThreads" Text="8 Threads" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT TABLE -->
            <Grid Grid.Column="1" Background="{DynamicResource ThemeBgMainContent}" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search & Status Filter Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <DockPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtSearch" TextChanged="OnSearchChanged" FontSize="11" Padding="6,3" 
                                     Background="{DynamicResource ThemeBgInput}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderStrong}" ToolTip="Tìm kiếm theo tên file"/>
                        </DockPanel>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="RadFilterAll" Content="Tất cả" IsChecked="True" Checked="OnFilterChanged"
                                         Style="{x:Null}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,10,0" Cursor="Hand"/>
                            <RadioButton x:Name="RadFilterRenamed" Content="Đã đổi" Checked="OnFilterChanged"
                                         Style="{x:Null}" Foreground="#10B981" FontSize="11" Margin="0,0,10,0" Cursor="Hand"/>
                            <RadioButton x:Name="RadFilterUnchanged" Content="Giữ nguyên" Checked="OnFilterChanged"
                                         Style="{x:Null}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,10,0" Cursor="Hand"/>
                            <RadioButton x:Name="RadFilterCollision" Content="Xung đột" Checked="OnFilterChanged"
                                         Style="{x:Null}" Foreground="#F59E0B" FontSize="11" Margin="0,0,10,0" Cursor="Hand"/>
                            <RadioButton x:Name="RadFilterLongPath" Content="⚠️ Dài &gt; 250" Checked="OnFilterChanged"
                                         Style="{x:Null}" Foreground="#EF4444" FontSize="11" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status & Warning Banners -->
                <StackPanel Grid.Row="1">
                    <!-- Long Path Warning Alert Banner with 1-click Auto Fix -->
                    <Border x:Name="BannerLongPath" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ Cảnh báo: " Foreground="#F87171" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Phát hiện " Foreground="#FCA5A5" FontSize="12"/>
                                <TextBlock x:Name="TxtLongPathCount" Text="0 tệp" Foreground="#FEF08A" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text=" có đường dẫn Full Path vượt quá ngưỡng an toàn (&gt; 250 ký tự)!" Foreground="#FCA5A5" FontSize="12"/>
                            </StackPanel>
                            <Button Content="⚡ Tự Động Co Gọn An Toàn (Smart Truncate)" Click="BtnAutoTruncate_Click"
                                    Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                    Padding="12,5" HorizontalAlignment="Right" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Status Banner / Notification -->
                    <Border x:Name="BannerMessage" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="TxtBanner" Text="Thông báo trạng thái" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center"/>
                            <Button Content="✕" Click="BtnCloseBanner_Click" Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- DataGrid & Loading Overlay -->
                <Border Grid.Row="2" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <DataGrid x:Name="GridFiles" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="Transparent" RowBackground="{DynamicResource ThemeGridRowBg}" AlternatingRowBackground="{DynamicResource ThemeGridRowAltBg}"
                                  Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource ThemeGridLines}" HeadersVisibility="Column"
                                  SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" FontSize="12" RowHeight="32">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource ThemeGridHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tên Ban Đầu" Binding="{Binding OriginalName}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tên Mới Dự Kiến" Binding="{Binding NewName}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#818CF8"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Độ Dài Path" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullPathLength}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border CornerRadius="4" Padding="4,1" Visibility="{Binding IsLongPath, Converter={StaticResource BoolToVis}}" Background="#7F1D1D">
                                                    <TextBlock Text="⚠️ Quá dài" Foreground="#FCA5A5" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="ready">
                                                                <Setter Property="Background" Value="#1E1B4B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="renamed">
                                                                <Setter Property="Background" Value="#064E3B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="unchanged">
                                                                <Setter Property="Background" Value="#1E293B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="collision_resolved">
                                                                <Setter Property="Background" Value="#451A03"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="ready">
                                                                    <Setter Property="Text" Value="Sẵn sàng"/>
                                                                    <Setter Property="Foreground" Value="#A5B4FC"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="renamed">
                                                                    <Setter Property="Text" Value="✔ Đã đổi"/>
                                                                    <Setter Property="Foreground" Value="#34D399"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="unchanged">
                                                                    <Setter Property="Text" Value="Giữ nguyên"/>
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="collision_resolved">
                                                                    <Setter Property="Text" Value="Trùng: _1"/>
                                                                    <Setter Property="Foreground" Value="#FBBF24"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Thao Tác" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📂" ToolTip="Mở trong File Explorer" Click="BtnOpenFile_Click"
                                                    Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0"
                                                    FontSize="12" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Loading Overlay khi quét thư mục hoặc nạp dữ liệu hiển thị -->
                        <Border x:Name="PanelGridLoading" Background="{DynamicResource ThemeGridOverlay}" CornerRadius="10" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="280" Height="6" Background="{DynamicResource ThemeBorder}" Foreground="#6366F1" BorderThickness="0" Margin="0,0,0,16">
                                    <ProgressBar.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                                <TextBlock x:Name="TxtGridLoadingTitle" Text="Đang xử lý &amp; tải hiển thị danh sách..." Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtGridLoadingDesc" Text="Vui lòng chờ trong giây lát..." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" MaxWidth="550" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtGridSkipped" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <Button x:Name="BtnCancelScan" Content="✕ Dừng Quét" Click="BtnCancelScan_Click"
                                        Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                        Padding="14,6" Margin="0,14,0,0" HorizontalAlignment="Center" Cursor="Hand" ToolTip="Dừng quá trình quét ngay lập tức và giữ lại các tệp đã tìm thấy">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- MAIN WORKSPACE 2: IMAGE RESIZER MODE       -->
        <!-- ========================================== -->
        <Grid x:Name="ViewImageResizer" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: IMAGE RESIZER OPTIONS -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgSidebar}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- PRESETS -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📐 KÍCH THƯỚC ĐỊNH SẴN" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,8"/>
                                <RadioButton x:Name="RadPresetFHD" GroupName="PresetGroup" Content="FHD 1080p (1920 × 1080)" IsChecked="True" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPreset2K" GroupName="PresetGroup" Content="2K QHD (2560 × 1440)" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPresetHD" GroupName="PresetGroup" Content="HD 720p (1280 × 720)" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPresetWeb" GroupName="PresetGroup" Content="Web Chuẩn (1024 × 768)" Checked="OnPresetChanged"/>
                                <RadioButton x:Name="RadPresetCustom" GroupName="PresetGroup" Content="Tùy chỉnh (Custom)" Checked="OnPresetChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- TARGET RESOLUTION -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎯 ĐỘ PHÂN GIẢI MỤC TIÊU" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Rộng max (px):" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtImgMaxWidth" Text="1920" TextChanged="OnImageOptionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Cao max (px):" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtImgMaxHeight" Text="1080" TextChanged="OnImageOptionChanged"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ChkImgKeepAspect" Content="Giữ nguyên tỷ lệ khung hình" IsChecked="True" FontWeight="SemiBold" Checked="OnImageOptionChanged" Unchecked="OnImageOptionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- QUALITY SLIDER -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="🎨 CHẤT LƯỢNG NÉN:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock x:Name="TxtImgQualityVal" Text="80%" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="SliderImgQuality" Minimum="10" Maximum="100" Value="80" SmallChange="5" LargeChange="10" 
                                        ValueChanged="OnImageQualityChanged" Margin="0,4,0,4" Cursor="Hand"/>
                                <TextBlock Text="Khuyến nghị 75% - 85% cho ảnh web/lưu trữ" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                            </StackPanel>
                        </Border>

                        <!-- OUTPUT FORMAT -->
                        <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🔄 ĐỊNH DẠNG XUẤT" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,8"/>
                                <RadioButton x:Name="RadImgFmtOriginal" GroupName="ImgFmtGroup" Content="Giữ định dạng gốc" IsChecked="True" Checked="OnImageOptionChanged"/>
                                <RadioButton x:Name="RadImgFmtJpeg" GroupName="ImgFmtGroup" Content="Chuyển sang JPEG (.jpg) - Nén tốt nhất" Checked="OnImageOptionChanged"/>
                                <RadioButton x:Name="RadImgFmtPng" GroupName="ImgFmtGroup" Content="Chuyển sang PNG (.png)" Checked="OnImageOptionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- OVERWRITE & SAFETY NOTICE CARD -->
                        <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="⚠️ BẢO VỆ GHI ĐÈ AN TOÀN" FontWeight="Bold" FontSize="11" Foreground="#F87171" Margin="0,0,0,6"/>
                                <TextBlock Text="• Tự động BỎ QUA nếu ảnh ban đầu đã nhỏ hơn mục tiêu (tránh phóng to/làm lớn ảnh)." Foreground="#FECACA" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="• Tự động HỦY nếu kích thước sau nén lớn hơn bản gốc." Foreground="#FECACA" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="• Ghi đè tệp tạm nguyên tử, bảo vệ an toàn tối đa cho tệp gốc." Foreground="#FECACA" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT TABLE: IMAGE LIST -->
            <Grid Grid.Column="1" Background="{DynamicResource ThemeBgMainContent}" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: Selection Chips, Search & Overwrite Action -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selection Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Content="Tất cả" Click="BtnImgSelectAll_Click"
                                    Background="{DynamicResource ThemeBgCardAlt}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                                    FontSize="10" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="Bỏ chọn" Click="BtnImgDeselectAll_Click"
                                    Background="{DynamicResource ThemeBgCardAlt}" Foreground="{DynamicResource ThemeTextSecondary}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                                    FontSize="10" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="&gt; 2 MB" Click="BtnImgSelectLargeSize_Click"
                                    Background="{DynamicResource ThemeBgCardAlt}" Foreground="#F59E0B" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                                    FontSize="10" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="&gt; 1920 px" Click="BtnImgSelectLargeDim_Click"
                                    Background="{DynamicResource ThemeBgCardAlt}" Foreground="#818CF8" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                                    FontSize="10" FontWeight="SemiBold" Padding="8,4" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                            <Button Content="⚡ Chỉ ảnh &gt; mục tiêu" Click="BtnImgSelectOverTarget_Click"
                                    Background="#4F46E5" Foreground="White" BorderThickness="0"
                                    FontSize="10" FontWeight="Bold" Padding="10,4" Cursor="Hand" ToolTip="Tự động chỉ tích chọn các ảnh có kích thước lớn hơn kích thước mục tiêu đã chọn">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Search Box -->
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtImgSearch" TextChanged="OnImgSearchChanged" FontSize="11" Padding="6,3" 
                                     Background="{DynamicResource ThemeBgInput}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderStrong}" ToolTip="Tìm kiếm theo tên file ảnh"/>
                        </DockPanel>

                        <!-- Execute Overwrite Action Button -->
                        <Button x:Name="BtnExecuteOverwrite" Grid.Column="2" Content="⚡ Tiến Hành Ghi Đè (0 ảnh)" Click="BtnExecuteOverwrite_Click"
                                Background="#DC2626" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" FontSize="12" Padding="16,6" HorizontalAlignment="Right" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- DataGrid for Images -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10">
                    <DataGrid x:Name="GridImages" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" RowBackground="{DynamicResource ThemeGridRowBg}" AlternatingRowBackground="{DynamicResource ThemeGridRowAltBg}"
                              Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource ThemeGridLines}" HeadersVisibility="Column"
                              SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" FontSize="12" RowHeight="32">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ThemeGridHeaderBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Checkbox Select -->
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ChkImgHeaderAll" Checked="OnImgHeaderCheckAll" Unchecked="OnImgHeaderUncheckAll" HorizontalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="OnImgItemSelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Index -->
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" IsReadOnly="True"/>

                            <!-- File Name -->
                            <DataGridTextColumn Header="Tên Tệp Ảnh" Binding="{Binding FileName}" Width="2*" IsReadOnly="True"/>

                            <!-- Original Dimensions -->
                            <DataGridTextColumn Header="Kích Thước Gốc" Binding="{Binding OriginalDimensions}" Width="120" IsReadOnly="True"/>

                            <!-- Target Dimensions -->
                            <DataGridTemplateColumn Header="Kích Thước Mới" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TargetDimensionsDisplay}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#818CF8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlreadySmaller}" Value="True">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Original Size -->
                            <DataGridTextColumn Header="Dung Lượng Gốc" Binding="{Binding OriginalSizeFormatted}" Width="110" IsReadOnly="True"/>

                            <!-- New Size -->
                            <DataGridTextColumn Header="Dung Lượng Mới" Binding="{Binding NewSizeFormatted}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#34D399"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="ready">
                                                            <Setter Property="Background" Value="#1E1B4B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="success">
                                                            <Setter Property="Background" Value="#064E3B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="skipped_smaller">
                                                            <Setter Property="Background" Value="#451A03"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="skipped_larger">
                                                            <Setter Property="Background" Value="#451A03"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="error">
                                                            <Setter Property="Background" Value="#450A0A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="ready">
                                                                <Setter Property="Foreground" Value="#A5B4FC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="success">
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="skipped_smaller">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="skipped_larger">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="error">
                                                                <Setter Property="Foreground" Value="#F87171"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Thao Tác" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📂" ToolTip="Mở trong File Explorer" Click="BtnOpenImageInExplorer_Click"
                                                Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0"
                                                FontSize="12" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER BAR -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeBgFooter}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtItemCount" Text="Sẵn sàng: 0 tệp tin" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                <TextBlock Text="C# .NET 11 + WIC Hardware Accelerated Image Engine" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- CONFIRM OVERWRITE MODAL DIALOG             -->
        <!-- ========================================== -->
        <Border x:Name="ModalConfirmOverwrite" Grid.RowSpan="4" Background="#E6020617" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="#EF4444" BorderThickness="2" CornerRadius="12" 
                    Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#7F1D1D" Margin="0,0,12,0">
                            <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="XÁC NHẬN GHI ĐÈ TRỰC TIẾP LÊN ẢNH GỐC" FontWeight="Bold" FontSize="14" Foreground="#EF4444"/>
                            <TextBlock Text="Hành động này sẽ thay đổi vĩnh viễn tệp trên đĩa!" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <TextBlock Text="CẢNH BÁO: Kích thước và dung lượng ảnh sẽ được nén và ghi đè trực tiếp lên file gốc. Dữ liệu gốc sẽ KHÔNG THỂ KHÔI PHỤC sau khi thực hiện. Vui lòng đảm bảo bạn đã có bản sao lưu nếu cần thiết."
                                   Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                    </Border>

                    <Border Background="{DynamicResource ThemeBgCardAlt}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Text="Số lượng ảnh được chọn ghi đè:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalCount" Text="0 tệp" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Số ảnh tự động giữ nguyên (đã nhỏ hơn):" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalSkipped" Text="0 tệp" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Kích thước mục tiêu:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalTargetDim" Text="Max 1920 × 1080 px" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Chất lượng nén:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalQuality" Text="80%" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Định dạng xuất:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBlock x:Name="TxtModalFormat" Text="Giữ định dạng gốc" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkAgreeOverwrite" Content="Tôi đã kiểm tra kỹ danh sách và đồng ý ghi đè trực tiếp" 
                              FontWeight="Bold" Foreground="#FEF08A" Margin="0,0,0,18" Checked="OnAgreeOverwriteChanged" Unchecked="OnAgreeOverwriteChanged"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="✕ Hủy Bỏ" Click="BtnCancelOverwrite_Click"
                                Background="{DynamicResource ThemeBgCardAlt}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="12" Padding="14,9" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnConfirmOverwriteExecute" Grid.Column="1" Content="⚡ Tiến Hành Ghi Đè Ngay" Click="BtnConfirmOverwriteExecute_Click"
                                Background="#DC2626" Foreground="White" BorderThickness="0" IsEnabled="False"
                                FontWeight="Bold" FontSize="12" Padding="14,9" Margin="6,0,0,0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========================================== -->
        <!-- IMAGE PROCESSING PROGRESS OVERLAY          -->
        <!-- ========================================== -->
        <Border x:Name="PanelImageProgress" Grid.RowSpan="4" Background="#E6020617" Visibility="Collapsed" Panel.ZIndex="99">
            <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1" CornerRadius="12"
                    Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="TxtImgProgressTitle" Text="Đang xử lý nén &amp; giảm kích thước ảnh..." 
                               FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ProgressBar x:Name="ProgressImgBar" Minimum="0" Maximum="100" Height="8" Background="{DynamicResource ThemeBorder}" Foreground="#EF4444" BorderThickness="0" Margin="0,0,0,10">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                    <TextBlock x:Name="TxtImgProgressFile" Text="IMG_001.JPG" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,16" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                    <Button x:Name="BtnCancelImageResize" Content="✕ Dừng Xử Lý" Click="BtnCancelImageResize_Click"
                            Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                            Padding="16,7" HorizontalAlignment="Center" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
